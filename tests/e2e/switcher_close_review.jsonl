{"scenario": {"window_size": "1440x900", "description": "Close review (DESIGN §4.1): a row beside an open review has a menu (a right-click, or its `⋯`) with Close review, which closes the review without approving it, the row dropping it and the switcher staying open; the review open in the window has the item disabled (\"It's open in this window\"); screenshots of both menus."}}
{"cmd": "wait_ready", "timeout_ms": 20000}
{"cmd": "set_setting", "key": "mode", "value": "dark"}
{"cmd": "settle"}
{"cmd": "seed_repo", "name": "api", "steps": [{"write": "app.ts", "text": "export const app = 1;\n"}, {"commit": "base"}, {"write": "app.ts", "text": "export const app = 2;\n"}], "save": {"api_repo": "/path"}}
{"cmd": "seed_repo", "name": "web", "steps": [{"write": "index.ts", "text": "export const web = 1;\n"}, {"commit": "base"}, {"write": "index.ts", "text": "export const web = 2;\n"}], "save": {"web_repo": "/path"}}
{"cmd": "open_review", "path": "${web_repo}"}
{"cmd": "settle", "timeout_ms": 20000, "expect": [{"pointer": "/session/total", "equals": 1}]}
{"cmd": "open_review", "path": "${api_repo}"}
{"cmd": "settle", "timeout_ms": 20000, "expect": [{"pointer": "/session/total", "equals": 1}, {"pointer": "/repos", "len": 2}]}

// The switcher: both working rows stand beside their open reviews.
{"cmd": "key", "keystroke": "secondary-o"}
{"cmd": "settle", "expect": [{"pointer": "/switcher/open", "equals": true}, {"pointer": "/switcher/menu", "equals": null}, {"pointer": "/switcher/items", "contains": {"key": "web/working", "review": {"status": "open"}}}, {"pointer": "/switcher/items", "contains": {"key": "api/working", "review": {"status": "open"}}}]}

// The review open in the window: a right-click opens its row's menu with the item disabled;
// Esc closes the menu and leaves the switcher open.
{"cmd": "click", "target": "switcher/api/working", "button": "right"}
{"cmd": "settle", "expect": [{"pointer": "/switcher/menu/repo", "equals": "${api_repo}"}, {"pointer": "/switcher/menu/closable", "equals": false}]}
{"cmd": "screenshot", "name": "menu-open-review"}
{"cmd": "key", "keystroke": "escape"}
{"cmd": "settle", "expect": [{"pointer": "/switcher/menu", "equals": null}, {"pointer": "/switcher/open", "equals": true}]}

// web's review: its `⋯` opens the menu, and Close review closes it.
{"cmd": "click", "target": "switcher/web/working/more"}
{"cmd": "settle", "expect": [{"pointer": "/switcher/menu/repo", "equals": "${web_repo}"}, {"pointer": "/switcher/menu/closable", "equals": true}]}
{"cmd": "screenshot", "name": "menu"}
{"cmd": "click", "target": "switcher/menu/close"}
{"cmd": "settle", "expect": [{"pointer": "/switcher/open", "equals": true}, {"pointer": "/switcher/menu", "equals": null}, {"pointer": "/switcher/items", "contains": {"key": "web/working", "review": null}}, {"pointer": "/switcher/items", "contains": {"key": "api/working", "review": {"status": "open"}}}]}
{"cmd": "screenshot", "name": "closed"}
{"cmd": "key", "keystroke": "escape"}
{"cmd": "settle", "expect": [{"pointer": "/switcher/open", "equals": false}]}
