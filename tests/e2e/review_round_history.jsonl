{"cmd": "key", "keystroke": "ctrl-enter"}
{"cmd": "settle", "expect": [{"pointer": "/session/composer", "equals": null}, {"pointer": "/session/threads/0/replies/0/body", "equals": "Better. Keep the rounding at one digit."}, {"pointer": "/session/threads/0/start_line", "equals": 6}, {"pointer": "/session/threads/0/end_line", "equals": 7}, {"pointer": "/session/threads/0/round", "equals": 1}, {"pointer": "/session/threads/0/trail/start", "equals": 6}]}

