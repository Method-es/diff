{"scenario": {"window_size": "1440x900", "lsp": {"typescript": "fixtures/lsp/review_intel_stacked_ts.json", "tailwindcss": "fixtures/lsp/review_intel_stacked_tw.json"}, "description": "Several servers on one file and hovers in class strings (PLAN §18.1, §18.4, DESIGN §4.1): a .tsx in a Tailwind v4 project gets TypeScript and Tailwind CSS, both started with the review; the pointer on the 500 of bg-red-500 asks both at that character, TypeScript says nothing inside a string (as tsc does) and Tailwind's card spans the class (its range), so moving onto `red` keeps it without asking again; on `className` both answer (Tailwind's answer there is the mock's, to stack two) and the card stacks them in the registry's order, labelled; `title` only TypeScript answers; on rounded-lg Tailwind answers at once and TypeScript is slow, and leaving the class cancels TypeScript's request ($/cancelRequest in the log); screenshots of the class card, the stacked card (dark, light) and the single one."}}
{"cmd": "wait_ready", "timeout_ms": 20000}
{"cmd": "set_setting", "key": "mode", "value": "dark"}
{"cmd": "settle"}
{"cmd": "seed_repo", "name": "web", "steps": [{"write": "package.json", "text": "{\"name\": \"web\", \"devDependencies\": {\"typescript\": \"^7\", \"tailwindcss\": \"^4\"}}\n"}, {"write": "tsconfig.json", "text": "{}\n"}, {"write": "src/app.css", "text": "@import \"tailwindcss\";\n"}, {"write": "src/Card.tsx", "text": "export function Card({ title }: { title: string }) {\n  return <div className=\"rounded-lg p-2\">{title}</div>;\n}\n"}, {"commit": "base"}, {"write": "src/Card.tsx", "text": "export function Card({ title }: { title: string }) {\n  return <div className=\"rounded-lg bg-red-500 p-4\">{title}</div>;\n}\n"}]}
{"cmd": "open_review", "path": "${data_dir}/repos/web"}
{"cmd": "settle", "expect": [{"pointer": "/intel/servers", "len": 2}, {"pointer": "/intel/servers/0/id", "equals": "typescript"}, {"pointer": "/intel/servers/0/state", "equals": "ready"}, {"pointer": "/intel/servers/1/id", "equals": "tailwindcss"}, {"pointer": "/intel/servers/1/state", "equals": "ready"}, {"pointer": "/intel/missing", "len": 0}]}
// The 5 of bg-red-500: asked at that character; Tailwind's range is the whole class.
