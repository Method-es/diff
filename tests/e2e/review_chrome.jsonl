{"scenario": {"window_size": "1440x900", "description": "The screen around the stream: dv open on a seeded repo opens the switcher with its uncommitted changes, the keyboard filters and opens the working review, the file list (current file, viewed checkbox, filter), Ctrl B and the panel's resize, the source picker, the status bar, a WSL repo's row and banner (and after a restart its stopped distro's Start row, then with the distro running its failed connection's Retry row), a long repo name at the minimum width, a repo whose .git went away; screenshots in dark Mica, dark Opaque and light."}}
{"cmd": "wait_ready", "timeout_ms": 20000}
{"cmd": "settle"}
{"expect": [{"pointer": "/switcher/open", "equals": false}, {"pointer": "/shell/empty_state", "equals": "no_review"}, {"pointer": "/shell/status/location", "equals": "No repo"}, {"pointer": "/file_list/shown", "equals": []}]}

// The board's fixture: two routes, a new cache module, an http change, a migration, package.json and the README.
{"cmd": "seed_repo", "name": "api-server", "steps": [{"write": "src/routes/users.ts", "text": "import { db } from \"../db\";\nimport type { User } from \"../types\";\n\nexport const users = Router();\n\nusers.get(\"/:id\", async (req, res) => {\n  const user = await db.users.find(req.params.id);\n  if (!user) return res.status(404).end();\n  res.json({ id: user.id, name: user.name });\n});\n"}, {"write": "src/routes/users.test.ts", "text": "import { users } from \"./users\";\n\ntest(\"GET /users/:id\", async () => {\n  expect(users).toBeDefined();\n});\n"}, {"write": "src/lib/http.ts", "text": "export async function get(url: string) {\n  const response = await fetch(url, { signal: AbortSignal.timeout(5000) });\n  return response.json();\n}\n"}, {"write": "package.json", "text": "{\n  \"name\": \"api-server\",\n  \"version\": \"1.4.0\"\n}\n"}, {"write": "README.md", "text": "# api-server\n\nThe users API.\n"}, {"commit": "base"}, {"write": "src/routes/users.ts", "text": "import { db } from \"../db\";\nimport { cache } from \"../lib/cache\";\nimport type { User } from \"../types\";\n\nexport const users = Router();\n\nexport async function fetchUser(id: string): Promise<User | null> {\n  const key = `user:${id.toLowerCase()}`;\n  const hit = cache.get<User>(key);\n  if (hit) return hit;\n  const user = await db.users.find(id);\n  if (user) cache.set(key, user, 60_000);\n  return user;\n}\n\nusers.get(\"/:id\", async (req, res) => {\n  const user = await fetchUser(req.params.id);\n  if (!user) return res.status(404).json({ error: \"not_found\" });\n  res.json({ id: user.id, name: user.name, email: user.email });\n});\n"}, {"write": "src/routes/users.test.ts", "text": "import { users } from \"./users\";\n\ntest(\"GET /users/:id\", async () => {\n  expect(users).toBeDefined();\n});\n\ntest(\"GET /users/:id caches by normalised id\", async () => {\n  expect(true).toBe(true);\n});\n"}, {"write": "src/lib/cache.ts", "text": "const entries = new Map<string, { value: unknown; until: number }>();\n\nexport const cache = {\n  get<T>(key: string): T | undefined {\n    const entry = entries.get(key);\n    return entry && entry.until > Date.now() ? (entry.value as T) : undefined;\n  },\n  set(key: string, value: unknown, ttl: number) {\n    entries.set(key, { value, until: Date.now() + ttl });\n  },\n};\n"}, {"write": "src/lib/http.ts", "text": "import { config } from \"../config\";\n\nexport async function get(url: string) {\n  const response = await fetch(url, { signal: AbortSignal.timeout(config.timeoutMs) });\n  return response.json();\n}\n"}, {"write": "src/db/migrations/0042_add_email.sql", "text": "ALTER TABLE users ADD COLUMN email TEXT;\n"}, {"write": "package.json", "text": "{\n  \"name\": \"api-server\",\n  \"version\": \"1.5.0\"\n}\n"}, {"write": "README.md", "text": "# api-server\n\nThe users API, with a cache in front of the database.\n"}], "save": {"repo": "/path"}}

// `open` (dv open <path>) adds the repo and opens the switcher on its uncommitted changes.
{"cmd": "open", "path": "${repo}", "expect_result": {"pointer": "/path", "equals": "${repo}"}}
{"cmd": "wait_for", "pointer": "/repos/0/working/files", "equals": 7, "timeout_ms": 20000}
{"cmd": "settle", "timeout_ms": 20000}
{"expect": [{"pointer": "/switcher/open", "equals": true}, {"pointer": "/switcher/query", "equals": ""}, {"pointer": "/switcher/selected", "equals": "api-server/working"}, {"pointer": "/switcher/items/0", "equals": {"key": "api-server/working", "kind": "target", "target": "working", "label": "Uncommitted changes", "starting": false, "repo": "${repo}", "review": null}}, {"pointer": "/switcher/items/1/key", "equals": "api-server/staged"}, {"pointer": "/switcher/items/2/key", "equals": "open_folder"}, {"pointer": "/repos/0/working", "equals": {"files": 7, "additions": 34, "deletions": 6}}]}
{"cmd": "bounds", "target": "switcher/repo/api-server", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "bounds", "target": "switcher", "expect_result": [{"pointer": "/w", "equals": 560}, {"pointer": "/y", "gte": 40}, {"pointer": "/y", "lte": 46}]}
{"cmd": "screenshot", "name": "switcher-dark-mica"}

// Typing filters the rows; ↓/↑ move the selection and wrap.
{"cmd": "type", "text": "stag", "expect": [{"pointer": "/switcher/query", "equals": "stag"}, {"pointer": "/switcher/items", "len": 2}, {"pointer": "/switcher/selected", "equals": "api-server/staged"}]}
{"cmd": "keys", "keys": "backspace backspace backspace backspace", "expect": [{"pointer": "/switcher/items", "len": 3}, {"pointer": "/switcher/selected", "equals": "api-server/working"}]}
{"cmd": "keys", "keys": "down down down", "expect": {"pointer": "/switcher/selected", "equals": "api-server/working"}}

// Enter opens the working review: the file list, the stream's current file and the status bar follow.
{"cmd": "key", "keystroke": "enter"}
{"cmd": "settle", "timeout_ms": 20000}
{"expect": [{"pointer": "/switcher/open", "equals": false}, {"pointer": "/session/target", "equals": "working"}, {"pointer": "/session/target_label", "equals": "working tree vs main"}, {"pointer": "/session/total", "equals": 7}, {"pointer": "/session/viewed", "equals": 0}, {"pointer": "/shell/empty_state", "equals": null}, {"pointer": "/file_list/shown", "equals": ["README.md", "package.json", "src/db/migrations/0042_add_email.sql", "src/lib/cache.ts", "src/lib/http.ts", "src/routes/users.test.ts", "src/routes/users.ts"]}, {"pointer": "/file_list/current_file", "equals": "README.md"}, {"pointer": "/session/current_file", "equals": "README.md"}]}
{"expect": [{"pointer": "/shell/status", "equals": {"health": "live", "location": "Local · watching for changes", "review": "Open · round 1 · no comments", "finish": true}}, {"pointer": "/session/files/2/status", "equals": "untracked"}, {"pointer": "/session/files/6", "contains": {"path": "src/routes/users.ts", "status": "modified", "additions": 13, "deletions": 3}}]}
{"cmd": "bounds", "target": "statusbar/location", "expect_result": [{"pointer": "/visible", "not_equals": null}, {"pointer": "/y", "gte": 872}]}
{"cmd": "bounds", "target": "statusbar/review", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "bounds", "target": "statusbar/finish", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "bounds", "target": "titlebar/source", "expect_result": {"pointer": "/visible", "not_equals": null}}

// A row's click makes its file the stream's current one; its checkbox marks it viewed through the store.
{"cmd": "click", "target": "file_list/src/routes/users.ts", "expect": {"pointer": "/file_list/current_file", "equals": "src/routes/users.ts"}}
{"cmd": "bounds", "target": "file_list/src/routes/users.ts", "expect_result": [{"pointer": "/h", "equals": 28}, {"pointer": "/w", "gte": 267}, {"pointer": "/w", "lte": 268}]}
{"cmd": "click", "target": "file_list/src/routes/users.ts/viewed"}
{"cmd": "wait_for", "pointer": "/session/viewed", "equals": 1}
{"cmd": "click", "target": "file_list/package.json/viewed"}
