{"cmd": "key", "keystroke": "escape", "expect": [{"pointer": "/file_list/query", "equals": ""}, {"pointer": "/file_list/shown", "len": 7}]}

// Ctrl B hides the panel and gives the main area the width; again shows it.
{"cmd": "key", "keystroke": "ctrl-b", "expect": {"pointer": "/shell/panel_visible", "equals": false}}
{"cmd": "bounds", "target": "shell/main", "expect_result": [{"pointer": "/x", "equals": 0}, {"pointer": "/w", "equals": 1440}]}
{"cmd": "key", "keystroke": "ctrl-b", "expect": {"pointer": "/shell/panel_visible", "equals": true}}

// Dragging the panel's edge resizes it within 220–420 and saves the width; a double click restores 280.
{"cmd": "drag", "from": "shell/panel/resize", "to": [340, 500]}
{"cmd": "settle"}
{"expect": {"pointer": "/shell/panel_width", "equals": 340}}
{"cmd": "bounds", "target": "shell/panel", "expect_result": {"pointer": "/w", "equals": 340}}
{"cmd": "drag", "from": "shell/panel/resize", "to": [900, 500]}
{"cmd": "settle", "expect": {"pointer": "/shell/panel_width", "equals": 420}}
{"cmd": "click", "target": "shell/panel/resize", "count": 2}
{"cmd": "settle", "expect": {"pointer": "/shell/panel_width", "equals": 280}}

// The source picker lists the repo's targets with the open review checked.
{"cmd": "click", "target": "titlebar/source"}
{"cmd": "settle", "timeout_ms": 20000}
{"expect": [{"pointer": "/source_picker/open", "equals": true}, {"pointer": "/source_picker/selected", "equals": "working"}, {"pointer": "/source_picker/items/0/label", "equals": "Uncommitted changes"}, {"pointer": "/source_picker/items/0/review/status", "equals": "open"}, {"pointer": "/source_picker/items/1/label", "equals": "Staged changes"}]}
{"cmd": "key", "keystroke": "escape", "expect": {"pointer": "/source_picker/open", "equals": false}}

// A WSL repo (PLAN §5.2). This run reaches WSL through the stand-in (no DV_WSL_HOME), which
// lists the distros it is told of and never starts anything in one: `open` connects, the
// stand-in refuses, and since the distro still isn't running the row offers Start again,
// keeping why the start failed (the row `open` named has the selection: its Start); opening
// its review shows a banner over the main area only, its headline one line, why and the
// connection's diagnostics in Details (DESIGN §4.4).
{"cmd": "wsl_distros", "distros": [{"name": "Ubuntu", "running": false}]}
{"cmd": "open", "path": "\\\\wsl.localhost\\Ubuntu\\home\\kyle\\web"}
{"cmd": "settle", "timeout_ms": 20000}
{"expect": [{"pointer": "/switcher/open", "equals": true}, {"pointer": "/repos", "contains": {"name": "web", "error": {"message": "Ubuntu can't be opened: the connection to dv failed: couldn't start dv: an automation run starts dv in a WSL distro only with DV_WSL_HOME set (a scratch home inside the distro)"}, "working": null, "stopped": "Ubuntu", "retry": false}}, {"pointer": "/switcher/items", "contains": {"key": "web/start", "kind": "start", "label": "Start Ubuntu"}}, {"pointer": "/backends", "contains": {"name": "Ubuntu", "state": "failed"}}, {"pointer": "/switcher/selected", "equals": "web/start"}]}
{"cmd": "bounds", "target": "switcher/repo/web", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "screenshot", "name": "switcher-wsl-dark-mica"}
{"cmd": "key", "keystroke": "escape", "expect": {"pointer": "/switcher/open", "equals": false}}
{"cmd": "open_review", "path": "\\\\wsl.localhost\\Ubuntu\\home\\kyle\\web", "expect_error": "couldn't open Ubuntu:/home/kyle/web"}
{"cmd": "settle"}
{"expect": [{"pointer": "/shell/banner/message", "equals": "couldn't open Ubuntu:/home/kyle/web"}, {"pointer": "/shell/banner/detail", "contains": "Ubuntu can't be opened: the connection to dv failed: couldn't start dv: an automation run starts dv in a WSL distro only with DV_WSL_HOME set (a scratch home inside the distro)\n\nconnection: Ubuntu\nlauncher: automation's stand-in for dv in Ubuntu"}, {"pointer": "/session/target", "equals": "working"}]}
{"cmd": "bounds", "target": "banner/main", "expect_result": [{"pointer": "/x", "gte": 280}, {"pointer": "/y", "gte": 40}, {"pointer": "/y", "lte": 60}]}
{"cmd": "bounds", "target": "banner/main/retry", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "click", "target": "banner/main/copy"}
{"expect": [{"pointer": "/system/requests", "len": 1}, {"pointer": "/system/requests/0/kind", "equals": "clipboard"}, {"pointer": "/system/requests/0/text", "contains": "couldn't open Ubuntu:/home/kyle/web\n"}, {"pointer": "/system/requests/0/text", "contains": "only with DV_WSL_HOME set"}, {"pointer": "/system/requests/0/text", "contains": "\nhistory:\n"}]}
{"cmd": "screenshot", "name": "banner-dark-mica"}
// Details: why it didn't open, and the connection's diagnostics.
{"cmd": "click", "target": "banner/main/details"}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "banner-details-dark-mica"}
