// A repository whose .git goes away while its review is open: the switcher says why and
// offers no rows to open there (DESIGN §4.1), rather than a review that would write a store
// into a folder that is no longer a repository.
{"cmd": "seed_repo", "name": "gone", "steps": [{"write": "a.txt", "text": "a\n"}, {"commit": "base"}, {"write": "a.txt", "text": "b\n"}]}
{"cmd": "open_review", "path": "${data_dir}/repos/gone"}
{"cmd": "settle", "timeout_ms": 20000}
{"cmd": "repo_edit", "name": "gone", "steps": [{"remove": ".git"}]}
{"cmd": "settle", "timeout_ms": 20000}
{"cmd": "key", "keystroke": "ctrl-o"}
{"cmd": "settle", "timeout_ms": 20000}
{"expect": [{"pointer": "/repos/0/name", "equals": "gone"}, {"pointer": "/repos/0/error", "not_equals": null}, {"pointer": "/repos/0/working", "equals": null}, {"pointer": "/switcher/items/0/key", "equals": "customer-portal-frontend-service/working"}]}
{"cmd": "query", "prefix": "switcher/gone/", "expect_result": {"pointer": "", "len": 0}}
{"cmd": "screenshot", "name": "switcher-gone-dark-mica"}
{"cmd": "key", "keystroke": "escape", "expect": {"pointer": "/switcher/open", "equals": false}}

// After a restart nothing is connected: the WSL repo, its distro not running, lists as
// "Ubuntu isn't running" with one row, Start Ubuntu (PLAN §5.2), which connects (booting the
// distro) and then lists the repo as usual; the stand-in refuses and boots nothing, so the row
// keeps why and offers Start again. Once the distro runs, the failed connection's row offers
// Retry instead, which connects again (and fails the same way).
{"restart": {}}
{"cmd": "settle", "timeout_ms": 20000}
{"cmd": "wsl_distros", "distros": [{"name": "Ubuntu", "running": false}]}
{"cmd": "key", "keystroke": "ctrl-o"}
{"cmd": "settle", "timeout_ms": 20000}
{"expect": [{"pointer": "/repos", "contains": {"name": "web", "stopped": "Ubuntu", "starting": false, "error": {"message": "Ubuntu isn't running"}}}, {"pointer": "/switcher/items", "contains": {"key": "web/start", "kind": "start", "target": null, "label": "Start Ubuntu", "review": null}}, {"pointer": "/backends", "equals": []}]}
{"cmd": "bounds", "target": "switcher/web/start", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "screenshot", "name": "switcher-wsl-stopped-dark-mica"}
{"cmd": "click", "target": "switcher/web/start"}
{"cmd": "settle", "timeout_ms": 20000}
{"expect": [{"pointer": "/switcher/open", "equals": true}, {"pointer": "/repos", "contains": {"name": "web", "stopped": "Ubuntu", "starting": false, "retry": false, "error": {"message": "Ubuntu can't be opened: the connection to dv failed: couldn't start dv: an automation run starts dv in a WSL distro only with DV_WSL_HOME set (a scratch home inside the distro)"}}}, {"pointer": "/backends", "contains": {"name": "Ubuntu", "state": "failed"}}, {"pointer": "/switcher/selected", "equals": "web/start"}]}
{"cmd": "query", "prefix": "switcher/web/", "expect_result": [{"pointer": "", "len": 1}, {"pointer": "/0/target", "equals": "switcher/web/start"}]}
{"cmd": "screenshot", "name": "switcher-wsl-start-failed-dark-mica"}
{"cmd": "key", "keystroke": "escape", "expect": {"pointer": "/switcher/open", "equals": false}}
{"cmd": "wsl_distros", "distros": [{"name": "Ubuntu", "running": true}]}
{"cmd": "key", "keystroke": "ctrl-o"}
{"cmd": "settle", "timeout_ms": 20000}
{"expect": [{"pointer": "/repos", "contains": {"name": "web", "stopped": null, "retry": true, "starting": false, "error": {"message": "Ubuntu can't be opened: the connection to dv failed: couldn't start dv: an automation run starts dv in a WSL distro only with DV_WSL_HOME set (a scratch home inside the distro)"}}}, {"pointer": "/switcher/items", "contains": {"key": "web/retry", "kind": "retry", "target": null, "label": "Retry", "review": null}}]}
{"cmd": "bounds", "target": "switcher/web/retry", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "screenshot", "name": "switcher-wsl-retry-dark-mica"}
{"cmd": "click", "target": "switcher/web/retry"}
{"cmd": "settle", "timeout_ms": 20000}
{"expect": [{"pointer": "/switcher/open", "equals": true}, {"pointer": "/repos", "contains": {"name": "web", "retry": true, "starting": false}}, {"pointer": "/backends", "contains": {"name": "Ubuntu", "state": "failed", "generation": 2}}, {"pointer": "/switcher/selected", "equals": "web/retry"}]}
{"cmd": "key", "keystroke": "escape", "expect": {"pointer": "/switcher/open", "equals": false}}
