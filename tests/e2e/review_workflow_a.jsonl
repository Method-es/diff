{"scenario": {"window_size": "1440x900", "description": "PLAN §3 workflow A steps 1-3 by keyboard alone, then the agent's answer: the switcher shows the seeded api-server with its seven uncommitted changes, Enter opens the working review, V marks a file viewed (in the store), J and Shift Down select lines, C and typing compose, Ctrl Enter posts, Ctrl Enter opens the Finish round sheet on Request changes and Ctrl Enter finishes round 1 (snapshot, changes_requested, round 2, an empty interdiff since round 1; I shows all changes). The agent addresses and replies through review_op; the card shows it live; ] focuses the thread, R replies, X resolves. Screenshots of the composer, the sheet and the thread states in dark Mica, dark Opaque and light (unified); the review ends approved and read-only. No clicks."}}
{"cmd": "wait_ready", "timeout_ms": 20000}
{"cmd": "settle"}

// Step 1: the agent's uncommitted work in api-server (the board's fixture, seven changes).
{"cmd": "seed_repo", "name": "api-server", "steps": [{"config": ["core.autocrlf", "true"]}, {"write": "src/routes/users.ts", "text": "import { db } from \"../db\";\nimport type { User } from \"../types\";\n\nexport const users = Router();\n\nusers.get(\"/:id\", async (req, res) => {\n  const user = await db.users.find(req.params.id);\n  if (!user) return res.status(404).end();\n  res.json({ id: user.id, name: user.name });\n});\n"}, {"write": "src/lib/http.ts", "text": "export async function get(url: string) {\n\tconst response = await fetch(url, { signal: AbortSignal.timeout(5000) });\n\treturn response.json();\n}\n"}, {"write": "src/lib/legacy.ts", "text": "export const LEGACY = true;\nexport function old() {\n  return LEGACY;\n}\n"}, {"write": "src/db/schema.ts", "text": "export interface UserRow {\n  id: string;\n  name: string;\n}\n"}, {"write_crlf": "README.md", "text": "# api-server\n\nThe users API.\n\nRun it with npm start.\n"}, {"commit": "base"}, {"write": "src/routes/users.ts", "text": "import { db } from \"../db\";\nimport { cache } from \"../lib/cache\";\nimport type { User } from \"../types\";\n\nexport const users = Router();\n\nexport async function fetchUser(id: string): Promise<User | null> {\n  const key = `user:${id}`;\n  const hit = cache.get<User>(key);\n  if (hit) return hit;\n  const user = await db.users.find(id);\n  if (user) cache.set(key, user, 60_000);\n  return user;\n}\n\nusers.get(\"/:id\", async (req, res) => {\n  const user = await fetchUser(req.params.id);\n  if (!user) return res.status(404).json({ error: \"not_found\" });\n  res.json({ id: user.id, name: user.name, email: user.email });\n});\n"}, {"write": "src/lib/cache.ts", "text": "const entries = new Map<string, { value: unknown; until: number }>();\n\nexport const cache = {\n  get<T>(key: string): T | undefined {\n    const entry = entries.get(key);\n    return entry && entry.until > Date.now() ? (entry.value as T) : undefined;\n  },\n  set(key: string, value: unknown, ttl: number) {\n    entries.set(key, { value, until: Date.now() + ttl });\n  },\n};\n"}, {"write": "src/lib/http.ts", "text": "import { config } from \"../config\";\n\nexport async function get(url: string) {\n\tconst response = await fetch(url, { signal: AbortSignal.timeout(config.timeoutMs) });\n\treturn response.json();\n}\n"}, {"remove": "src/lib/legacy.ts"}, {"git": ["mv", "src/db/schema.ts", "src/db/models.ts"]}, {"write_crlf": "README.md", "text": "# api-server\n\nThe users API, with a cache in front of the database.\n\nRun it with npm start.\n"}, {"write": "src/routes/users.test.ts", "text": "import { fetchUser } from \"./users\";\n\ntest(\"caches a user\", async () => {\n  expect(await fetchUser(\"a\")).toEqual(await fetchUser(\"a\"));\n});\n"}]}
{"cmd": "open", "path": "${data_dir}/repos/api-server", "expect": [{"pointer": "/switcher/open", "equals": true}, {"pointer": "/switcher/selected", "equals": "api-server/working"}]}
{"cmd": "settle", "expect": [{"pointer": "/repos/0/name", "equals": "api-server"}, {"pointer": "/repos/0/working/files", "equals": 7}, {"pointer": "/repos/0/reviews", "len": 0}]}

// Step 2: Enter opens the working review.
{"cmd": "key", "keystroke": "enter"}
{"cmd": "settle"}
{"cmd": "wait_for", "pointer": "/session/total", "equals": 7}
{"cmd": "settle", "expect": [{"pointer": "/switcher/open", "equals": false}, {"pointer": "/session/target", "equals": "working"}, {"pointer": "/session/status", "equals": "open"}, {"pointer": "/session/round", "equals": 1}, {"pointer": "/session/current_file", "equals": "README.md"}, {"pointer": "/stream/focused", "equals": true}, {"pointer": "/comments_list/rows", "len": 0}]}

// Step 3: read, mark viewed (V: the event lands in the store and the fold reads it back),
// select lines (J, Shift Down), comment (C), post (Ctrl Enter).
{"cmd": "key", "keystroke": "v"}
{"cmd": "settle"}
{"cmd": "wait_for", "pointer": "/session/files/0/viewed", "equals": true}
{"expect": [{"pointer": "/session/files/0/path", "equals": "README.md"}, {"pointer": "/session/viewed", "equals": 1}, {"pointer": "/stream/files/0/collapsed", "equals": true}]}
{"cmd": "keys", "keys": "j j"}
{"cmd": "settle", "expect": [{"pointer": "/session/current_file", "equals": "src/lib/cache.ts"}, {"pointer": "/session/cursor", "equals": {"path": "src/lib/cache.ts", "side": "new", "line": 1}}]}
{"cmd": "keys", "keys": "shift-down shift-down"}
{"cmd": "settle", "expect": {"pointer": "/session/selection", "equals": {"path": "src/lib/cache.ts", "side": "new", "start_line": 1, "end_line": 3}}}
{"cmd": "key", "keystroke": "c"}
{"cmd": "settle", "expect": {"pointer": "/session/composer", "equals": {"path": "src/lib/cache.ts", "side": "new", "start_line": 1, "end_line": 3, "file_level": false, "reply_to": null, "text": "", "posting": false, "error": null}}}
// The composer has the keyboard: J and V type, they don't move or mark anything.
{"cmd": "type", "text": "Entries never expire from the map itself; add a sweep or **cap** the size. Just a JV note."}
{"cmd": "settle", "expect": [{"pointer": "/session/composer/text", "equals": "Entries never expire from the map itself; add a sweep or **cap** the size. Just a JV note."}, {"pointer": "/session/current_file", "equals": "src/lib/cache.ts"}, {"pointer": "/session/viewed", "equals": 1}]}
{"cmd": "screenshot", "name": "composer-dark-mica"}
{"cmd": "key", "keystroke": "ctrl-enter"}
{"cmd": "settle", "expect": [{"pointer": "/session/composer", "equals": null}, {"pointer": "/session/threads", "len": 1}, {"pointer": "/session/threads/0/path", "equals": "src/lib/cache.ts"}, {"pointer": "/session/threads/0/side", "equals": "new"}, {"pointer": "/session/threads/0/start_line", "equals": 1}, {"pointer": "/session/threads/0/end_line", "equals": 3}, {"pointer": "/session/threads/0/state", "equals": "open"}, {"pointer": "/session/threads/0/author/kind", "equals": "reviewer"}, {"pointer": "/session/threads/0/outdated", "equals": false}, {"pointer": "/session/selection", "equals": null}, {"pointer": "/session/files/2/open_threads", "equals": 1}, {"pointer": "/comments_list/rows", "len": 1}, {"pointer": "/shell/status/review", "equals": "Open · round 1 · 1 open"}]}
{"cmd": "state", "save": {"thread": "/session/threads/0/id"}, "expect": {"pointer": "/session/focused_thread", "equals": "${thread}"}}
// The panel's row reads the comment as the card renders it, its Markdown dropped.
{"cmd": "assert", "pointer": "/comments_list/rows/0/summary", "equals": "Entries never expire from the map itself; add a sweep or cap the size. Just a JV note."}
{"cmd": "screenshot", "name": "thread-open-dark-mica"}

// Request changes (Ctrl Enter): the sheet opens on Request changes, since a thread is open.
{"cmd": "key", "keystroke": "ctrl-enter"}
{"cmd": "settle", "expect": [{"pointer": "/session/sheet/verdict", "equals": "request_changes"}, {"pointer": "/session/sheet/can_submit", "equals": true}, {"pointer": "/session/sheet/tab", "equals": "write"}]}
{"cmd": "key", "keystroke": "up", "expect": {"pointer": "/session/sheet/verdict", "equals": "approve"}}
{"cmd": "key", "keystroke": "down", "expect": {"pointer": "/session/sheet/verdict", "equals": "request_changes"}}
{"cmd": "key", "keystroke": "tab"}
{"cmd": "type", "text": "One thing before this lands: the cache never sweeps."}
// `Ctrl O` opens the switcher over the sheet, which keeps the summary; `Esc` goes back to it.
{"cmd": "key", "keystroke": "ctrl-o"}
{"cmd": "settle", "expect": [{"pointer": "/switcher/open", "equals": true}, {"pointer": "/session/sheet/summary", "equals": "One thing before this lands: the cache never sweeps."}]}
{"cmd": "key", "keystroke": "escape"}
{"cmd": "settle", "expect": [{"pointer": "/switcher/open", "equals": false}, {"pointer": "/session/sheet/summary", "equals": "One thing before this lands: the cache never sweeps."}]}
{"cmd": "key", "keystroke": "tab"}
{"cmd": "settle", "expect": [{"pointer": "/session/sheet/summary", "equals": "One thing before this lands: the cache never sweeps."}, {"pointer": "/session/sheet/verdict", "equals": "request_changes"}]}
{"cmd": "screenshot", "name": "sheet-dark-mica"}
// Round 1 is snapshotted; status changes_requested; round 2 is current and nothing is viewed in it.
{"cmd": "key", "keystroke": "ctrl-enter"}
{"cmd": "settle"}
{"cmd": "wait_for", "pointer": "/session/status", "equals": "changes_requested"}
{"cmd": "settle", "expect": [{"pointer": "/session/sheet", "equals": null}, {"pointer": "/session/round", "equals": 2}, {"pointer": "/session/rounds", "len": 1}, {"pointer": "/session/rounds/0/n", "equals": 1}, {"pointer": "/session/rounds/0/verdict", "equals": "request_changes"}, {"pointer": "/session/rounds/0/new_oid", "not_equals": null}, {"pointer": "/session/rounds/0/body", "equals": "One thing before this lands: the cache never sweeps."}, {"pointer": "/session/viewed", "equals": 0}, {"pointer": "/stream/focused", "equals": true}]}
// Round 2 shows what changed since round 1 (PLAN §2.3): nothing yet, so the thread is in all
// changes only; `I` switches there.
{"expect": [{"pointer": "/session/comparison", "equals": {"kind": "since_round", "round": 1}}, {"pointer": "/session/comparison_available", "equals": true}, {"pointer": "/shell/empty_state", "equals": "no_changes_since"}, {"pointer": "/comments_list/rows/0/not_in_comparison", "equals": true}, {"pointer": "/shell/status/review", "equals": "Changes requested · round 2 · 1 open · since round 1"}]}
{"cmd": "key", "keystroke": "i"}
{"cmd": "settle", "expect": [{"pointer": "/session/comparison", "equals": {"kind": "all"}}, {"pointer": "/session/total", "equals": 7}, {"pointer": "/stream/files/0/collapsed", "equals": false}, {"pointer": "/comments_list/rows/0/not_in_comparison", "equals": false}, {"pointer": "/shell/status/review", "equals": "Changes requested · round 2 · 1 open"}]}

// The agent answers (review_op plays it until the CLI exists): addressed with a note, and a reply.
{"cmd": "review_op", "op": "address", "thread": "${thread}", "note": "Capped at 1,000 entries; the oldest goes first.", "author": "claude-code"}
{"cmd": "review_op", "op": "reply", "thread": "${thread}", "body": "Added `cache.sweep()` and a test in `cache.test.ts`.", "author": "claude-code"}
{"cmd": "wait_for", "pointer": "/session/threads/0/replies", "len": 1, "timeout_ms": 15000}
{"cmd": "wait_for", "pointer": "/session/threads/0/state", "equals": "addressed", "timeout_ms": 15000}
{"cmd": "settle", "expect": [{"pointer": "/session/threads/0/note", "equals": "Capped at 1,000 entries; the oldest goes first."}, {"pointer": "/comments_list/rows/0/state", "equals": "addressed"}, {"pointer": "/shell/status/review", "equals": "Changes requested · round 2 · 1 addressed"}]}
{"cmd": "key", "keystroke": "]", "expect": {"pointer": "/session/focused_thread", "equals": "${thread}"}}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "addressed-dark-mica"}
// R replies to the focused thread; X resolves it (it collapses to one line).
{"cmd": "key", "keystroke": "r", "expect": {"pointer": "/session/composer/reply_to", "equals": "${thread}"}}
{"cmd": "type", "text": "Thanks, that reads right."}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "reply-dark-mica"}
{"cmd": "key", "keystroke": "ctrl-enter"}
{"cmd": "settle", "expect": [{"pointer": "/session/composer", "equals": null}, {"pointer": "/session/threads/0/replies", "len": 2}, {"pointer": "/session/threads/0/replies/1/author/kind", "equals": "reviewer"}]}
{"cmd": "key", "keystroke": "x"}
{"cmd": "settle", "expect": [{"pointer": "/session/threads/0/state", "equals": "resolved"}, {"pointer": "/comments_list/rows", "len": 0}, {"pointer": "/shell/status/review", "equals": "Changes requested · round 2 · 1 resolved"}]}
{"cmd": "screenshot", "name": "resolved-dark-mica"}

// The same states in dark Opaque: X reopens, the agent addresses again, C composes, the sheet.
{"cmd": "set_setting", "key": "material", "value": "opaque"}
{"cmd": "key", "keystroke": "x"}
{"cmd": "settle", "expect": {"pointer": "/session/threads/0/state", "equals": "open"}}
{"cmd": "screenshot", "name": "thread-open-dark-opaque"}
{"cmd": "review_op", "op": "address", "thread": "${thread}", "note": "Swept on every set as well.", "author": "claude-code"}
{"cmd": "wait_for", "pointer": "/session/threads/0/state", "equals": "addressed", "timeout_ms": 15000}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "addressed-dark-opaque"}
// At the minimum width the split card is narrow: the anchor and the agent's name give way,
// Resolve and Reopen stay whole (DESIGN §4.1).
{"cmd": "resize", "w": 1100, "h": 700}
{"cmd": "settle"}
{"cmd": "bounds", "target": "thread/${thread}/resolve", "expect_result": [{"pointer": "/visible/w", "gte": 50}]}
{"cmd": "bounds", "target": "thread/${thread}/reopen", "expect_result": [{"pointer": "/visible/w", "gte": 50}]}
{"cmd": "screenshot", "name": "addressed-1100-dark-opaque"}
{"cmd": "resize", "w": 1440, "h": 900}
{"cmd": "settle"}
{"cmd": "key", "keystroke": "c"}
{"cmd": "type", "text": "Is the TTL in ms?"}
{"cmd": "settle", "expect": {"pointer": "/session/composer/text", "equals": "Is the TTL in ms?"}}
{"cmd": "screenshot", "name": "composer-dark-opaque"}
{"cmd": "key", "keystroke": "escape", "expect": [{"pointer": "/session/composer", "equals": null}, {"pointer": "/session/threads", "len": 1}]}
{"cmd": "key", "keystroke": "ctrl-enter"}
{"cmd": "settle", "expect": {"pointer": "/session/sheet/verdict", "equals": "approve"}}
{"cmd": "screenshot", "name": "sheet-dark-opaque"}
{"cmd": "key", "keystroke": "escape", "expect": {"pointer": "/session/sheet", "equals": null}}
{"cmd": "key", "keystroke": "x"}
{"cmd": "settle", "expect": {"pointer": "/session/threads/0/state", "equals": "resolved"}}
{"cmd": "screenshot", "name": "resolved-dark-opaque"}

// Light (Mica): reopened, composing, the sheet, then Approve finishes the review read-only.
{"cmd": "set_setting", "key": "material", "value": "mica"}
{"cmd": "set_setting", "key": "mode", "value": "light"}
{"cmd": "key", "keystroke": "x"}
{"cmd": "settle", "expect": {"pointer": "/session/threads/0/state", "equals": "open"}}
{"cmd": "key", "keystroke": "s", "expect": {"pointer": "/session/view_mode", "equals": "unified"}}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "thread-open-light"}
{"cmd": "key", "keystroke": "c"}
{"cmd": "type", "text": "Is the TTL in ms?"}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "composer-light"}
{"cmd": "key", "keystroke": "escape"}
{"cmd": "key", "keystroke": "ctrl-enter"}
{"cmd": "settle", "expect": {"pointer": "/session/sheet/verdict", "equals": "request_changes"}}
{"cmd": "key", "keystroke": "1", "expect": {"pointer": "/session/sheet/verdict", "equals": "approve"}}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "sheet-light"}
{"cmd": "key", "keystroke": "ctrl-enter"}
{"cmd": "settle"}
{"cmd": "wait_for", "pointer": "/session/status", "equals": "approved"}
{"cmd": "settle", "expect": [{"pointer": "/session/read_only", "equals": true}, {"pointer": "/session/round", "equals": 2}, {"pointer": "/session/rounds/1/verdict", "equals": "approve"}, {"pointer": "/shell/status/finish", "equals": false}, {"pointer": "/shell/status/review", "equals": "Approved · round 2 · 1 open"}]}
// Read-only: C opens nothing, Ctrl Enter opens no sheet, X changes nothing.
{"cmd": "keys", "keys": "c ctrl-enter x"}
{"cmd": "settle", "expect": [{"pointer": "/session/composer", "equals": null}, {"pointer": "/session/sheet", "equals": null}, {"pointer": "/session/threads/0/state", "equals": "open"}]}
{"cmd": "screenshot", "name": "approved-light"}
{"cmd": "query", "prefix": "banner/finished", "expect_result": {"pointer": "", "len": 2}}
