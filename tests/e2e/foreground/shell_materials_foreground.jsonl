{"scenario": {"window_size": "1440x900", "platforms": ["windows"], "foreground": true, "description": "The empty shell in every material and mode, captured from the screen as it is shown (Acrylic's blur-behind is missing from window-source captures). Takes the foreground for a few seconds: run on demand or with script/check --foreground, hands off the machine meanwhile (tests/e2e/README.md, Screenshots and window materials)"}}
{"cmd": "wait_ready", "timeout_ms": 20000}
{"cmd": "settle", "expect": [{"pointer": "/window/active", "equals": true}, {"pointer": "/window/background", "equals": false}, {"pointer": "/settings/available_materials", "equals": ["mica", "acrylic", "opaque"]}]}

{"cmd": "set_setting", "key": "material", "value": "mica"}
{"cmd": "set_setting", "key": "mode", "value": "dark"}
{"cmd": "settle", "expect": [{"pointer": "/settings/resolved_material", "equals": "mica"}, {"pointer": "/settings/resolved_mode", "equals": "dark"}, {"pointer": "/shell/window_material", "equals": "mica"}]}
// DWM fades a backdrop change in; give it time to finish before copying the screen.
{"cmd": "wait", "ms": 400}
{"cmd": "screenshot", "name": "shell-mica-dark-screen", "source": "screen", "expect_result": {"pointer": "/source", "equals": "screen"}}

