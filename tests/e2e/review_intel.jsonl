{"scenario": {"window_size": "1440x900", "lsp": {"typescript": "fixtures/lsp/review_intel.json"}, "description": "Code intelligence against mock_lsp (PLAN §18.1, §18.5, DESIGN §4.1): the TypeScript server starts once the file list shows (`intel.servers`, the status bar's item and its details); the pointer resting on an identifier opens the hover card (its text, Go to definition and Find references), moving off closes it and Esc closes it; Ctrl+click on a symbol defined in a file the review doesn't change opens the file view at its definition (the caret on it), Alt ← returns; F12 on a symbol defined near the change scrolls the stream there; Shift F12 lists the references in the panel's References tab, grouped by file with the changed row marked, In this review keeping that one; a row opens its place; closing the list takes the tabs away; screenshots of the hover card (dark, light), the references, the file view after a definition and the status bar's details."}}
{"cmd": "wait_ready", "timeout_ms": 20000}
{"cmd": "set_setting", "key": "mode", "value": "dark"}
{"cmd": "settle"}
// src/a.ts calls helper (src/b.ts, unchanged) on its changed line 6; src/c.ts calls it too.
{"cmd": "seed_repo", "name": "web", "steps": [{"write": "package.json", "text": "{\"name\": \"web\", \"devDependencies\": {\"typescript\": \"^7\"}}\n"}, {"write": "tsconfig.json", "text": "{}\n"}, {"write": "src/a.ts", "text": "import { helper, scale } from './b';\n\nexport function total(values: number[]): number {\n  let sum = 0;\n  for (const value of values) {\n    sum += value;\n  }\n  return scale(sum);\n}\n"}, {"write": "src/b.ts", "text": "/** Adds one to `x`. */\nexport function helper(x: number): number {\n  return x + 1;\n}\n\nexport function scale(x: number): number {\n  return x * 2;\n}\n"}, {"write": "src/c.ts", "text": "import { helper } from './b';\n\nexport const two = helper(1);\n"}, {"commit": "base"}, {"write": "src/a.ts", "text": "import { helper, scale } from './b';\n\nexport function total(values: number[]): number {\n  let sum = 0;\n  for (const value of values) {\n    sum += helper(value);\n  }\n  return scale(sum);\n}\n\nexport const answer = total([1, 2, 3]);\n"}]}
{"cmd": "open_review", "path": "${data_dir}/repos/web"}
{"cmd": "settle", "expect": [{"pointer": "/intel/servers/0/id", "equals": "typescript"}, {"pointer": "/intel/servers/0/state", "equals": "ready"}, {"pointer": "/intel/servers/0/source", "equals": "DV_LSP_TYPESCRIPT"}, {"pointer": "/intel/servers", "len": 1}, {"pointer": "/intel/missing", "len": 0}, {"pointer": "/intel/hover", "equals": null}, {"pointer": "/intel/panel_tab", "equals": "review"}]}
{"cmd": "query", "prefix": "statusbar/lsp/typescript", "expect_result": {"pointer": "", "len": 1}}

