{"cmd": "settle", "expect": [{"pointer": "/intel/hover/open", "equals": true}, {"pointer": "/intel/hover/symbol", "equals": "scale"}, {"pointer": "/intel/hover/side", "equals": "old"}, {"pointer": "/intel/hover/line", "equals": 8}]}
