{"cmd": "query", "prefix": "hover/", "expect_result": {"pointer": "", "len": 3}}
{"cmd": "screenshot", "name": "hover"}
// Off the token (onto a line number), it closes; back on it and Esc closes it too.
{"cmd": "mouse_move", "target": "stream/line/src/a.ts/new/9"}
{"cmd": "settle", "expect": {"pointer": "/intel/hover", "equals": null}}
{"cmd": "mouse_move", "target": "code/src/a.ts/new/6/14"}
{"cmd": "settle", "expect": {"pointer": "/intel/hover/open", "equals": true}}
{"cmd": "key", "keystroke": "escape"}
{"cmd": "settle", "expect": {"pointer": "/intel/hover", "equals": null}}
// Straight from one identifier onto another (the old column, clear of the card): the first card's grace closes the card, not the wait for the next.
