{"cmd": "wait", "ms": 800}
{"expect": [{"pointer": "/intel/hover/open", "equals": false}, {"pointer": "/intel/hover/line", "equals": 3}]}
{"cmd": "mouse_move", "target": "stream/line/src/a.ts/new/9"}
{"cmd": "settle", "expect": {"pointer": "/intel/hover", "equals": null}}
{"lsp_log": {}, "expect_result": {"pointer": "", "contains": {"received": {"method": "$/cancelRequest"}}}}
