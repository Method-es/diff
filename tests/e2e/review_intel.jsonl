{"cmd": "mouse_move", "target": "code/src/a.ts/new/6/14"}
{"cmd": "settle", "expect": [{"pointer": "/intel/hover/open", "equals": true}, {"pointer": "/intel/hover/symbol", "equals": "helper"}, {"pointer": "/intel/hover/line", "equals": 6}, {"pointer": "/intel/hover/pane", "equals": "stream"}, {"pointer": "/intel/hover/text", "contains": "function helper(x: number): number"}, {"pointer": "/intel/hover/text", "contains": "plus one"}, {"pointer": "/intel/hover/against_worktree", "equals": false}]}
