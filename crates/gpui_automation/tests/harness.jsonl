{"scenario": {"window_size": "1200x800", "description": "Exercises every gpui_automation command against examples/harness.rs"}}
// Start-up: readiness, state, window list, actions.
{"cmd": "wait_ready", "timeout_ms": 10000}
{"cmd": "state", "expect_result": [{"pointer": "/view", "equals": "main"}, {"pointer": "/window/name", "equals": "main"}, {"pointer": "/window/w", "equals": 1200}, {"pointer": "/window/h", "equals": 800}, {"pointer": "/window/fullscreen", "equals": false}, {"pointer": "/window/display/bounds/w", "gte": 1200}, {"pointer": "/data_dir", "equals": "${data_dir}"}]}
// Hermetic runs: the data dir comes as DV_DATA_DIR too; gh is mock_gh without a scenario file (no "gh" header), logging to the output dir; git can't look above that dir; the app runs in its data dir.
{"cmd": "state", "expect_result": [{"pointer": "/env/DV_DATA_DIR", "equals": "${data_dir}"}, {"pointer": "/env/DV_GH", "equals": "${dv_gh}"}, {"pointer": "/env/DV_GH", "contains": "mock_gh"}, {"pointer": "/env/DV_MOCK_GH", "equals": null}, {"pointer": "/env/DV_MOCK_GH_LOG", "equals": "${dv_mock_gh_log}"}, {"pointer": "/env/DV_MOCK_GH_LOG", "contains": "gh_calls.jsonl"}, {"pointer": "/env/GIT_CEILING_DIRECTORIES", "equals": "${out_dir}"}, {"pointer": "/cwd", "equals": "${data_dir}"}]}
// Nothing has called gh, so there is no log yet, which reads as no calls.
{"gh_log": {}, "expect_result": {"pointer": "", "len": 0}}
{"cmd": "windows", "expect_result": [{"pointer": "", "len": 1}, {"pointer": "/0", "contains": {"index": 0, "name": "main", "selected": true}}]}
{"cmd": "actions", "expect_result": [{"pointer": "", "contains": "harness::Increment"}, {"pointer": "", "contains": "harness::Reset"}]}
{"cmd": "screenshot", "name": "start", "expect_result": [{"pointer": "/logical/w", "equals": 1200}, {"pointer": "/w", "gte": 1200}]}

// Clicks by target and by coordinates, with modifiers, counts and buttons.
{"cmd": "click", "target": "counter/increment", "expect": {"pointer": "/counter", "equals": 1}}
{"cmd": "click", "x": 60, "y": 32, "expect": {"pointer": "/counter", "equals": 2}}
{"cmd": "click", "target": "counter/increment", "modifiers": "ctrl", "expect": {"pointer": "/counter", "equals": 12}}
{"cmd": "click", "target": "counter/value", "count": 2, "expect": {"pointer": "/double_clicks", "equals": 1}}
{"cmd": "click", "target": "counter/value", "button": "right", "expect": {"pointer": "/right_clicks", "equals": 1}}
{"cmd": "click", "x": 5000, "y": 10, "expect_error": "outside the 1200x800 window"}
{"cmd": "click", "target": "no/such/target", "expect_error": "no target \"no/such/target\""}

// Actions and keystrokes, including a two-keystroke chord.
{"cmd": "action", "name": "harness::Increment", "expect_result": {"pointer": "/action", "equals": "harness::Increment"}, "expect": {"pointer": "/counter", "equals": 13}}
{"cmd": "action", "name": "Increment", "expect_error": "ambiguous action Increment"}
{"cmd": "action", "name": "Reset", "expect_result": {"pointer": "/action", "equals": "harness::Reset"}, "expect": [{"pointer": "/counter", "equals": 0}, {"pointer": "/resets", "equals": 1}]}
{"cmd": "action", "name": "NoSuchAction", "expect_error": "unknown action"}
{"cmd": "key", "keystroke": "ctrl-i", "expect_result": {"pointer": "/handled", "equals": true}, "expect": {"pointer": "/counter", "equals": 1}}
{"cmd": "keys", "keys": "ctrl-k ctrl-r", "expect": [{"pointer": "/counter", "equals": 0}, {"pointer": "/resets", "equals": 2}]}
{"cmd": "keys", "keys": ["ctrl-i", "ctrl-i"], "expect": {"pointer": "/counter", "equals": 2}}
{"cmd": "keys", "keys": "ctrl-i ctrl-k-x", "expect_error": "keystroke 2"}

// Host custom commands, in-app assertions and argument validation.
{"cmd": "slow_set_counter", "value": 7, "ms": 150, "expect_result": {"pointer": "/counter", "equals": 7}, "expect": {"pointer": "/counter", "equals": 7}}
{"cmd": "slow_set_counter", "value": -1, "expect_error": "-1 is negative"}
{"cmd": "set_counter", "value": 41, "expect_result": {"pointer": "/counter", "equals": 41}, "expect": {"pointer": "/counter", "equals": 41}}
{"cmd": "echo", "hello": "world", "n": 3, "expect_result": {"pointer": "/hello", "equals": "world"}, "save": {"greeting": "/hello", "count": "/n"}}
{"cmd": "echo", "again": "${greeting} x${count}", "expect_result": {"pointer": "/again", "equals": "world x3"}}
{"cmd": "fail", "expect_error": "failed on purpose"}
{"cmd": "no_such_command", "expect_error": "unknown command"}
{"cmd": "assert", "pointer": "/counter", "equals": 41}
{"cmd": "assert", "pointer": "/counter", "equals": 40, "expect_error": "/counter: expected equals 40, got 41"}
{"cmd": "state", "verbose": true, "expect_error": "takes no arguments"}
{"cmd": "wait", "ms": 999999, "expect_error": "capped"}
{"cmd": "wait_frames", "n": 0, "expect_error": "between 1 and 600"}

// Typing into a gpui-component input.
{"cmd": "click", "target": "input", "expect": {"pointer": "/input/focused", "equals": true}}
{"cmd": "type", "text": "Hello, gpui!", "expect_result": {"pointer": "/typed", "equals": 12}, "expect": {"pointer": "/input/value", "equals": "Hello, gpui!"}}
{"cmd": "keys", "keys": "backspace backspace", "expect": {"pointer": "/input/value", "equals": "Hello, gpu"}}
{"cmd": "screenshot", "name": "typed"}

// Synchronisation: the slow button increments after 400ms, unsettling the host meanwhile.
{"cmd": "click", "target": "counter/slow", "expect": {"pointer": "/slow_pending", "equals": true}}
{"cmd": "wait_for", "pointer": "/counter", "equals": 42, "timeout_ms": 5000, "expect_result": {"pointer": "/actual", "equals": 42}}
{"cmd": "click", "target": "counter/slow"}
{"cmd": "wait_ready", "timeout_ms": 5000, "expect": {"pointer": "/counter", "equals": 43}}
{"cmd": "click", "target": "counter/slow"}
{"cmd": "settle", "timeout_ms": 5000, "expect": [{"pointer": "/counter", "equals": 44}, {"pointer": "/slow_pending", "equals": false}]}
{"cmd": "wait_for", "pointer": "/counter", "equals": 99, "timeout_ms": 300, "expect_error": "timed out after 300ms: /counter: expected equals 99, got 44"}
{"cmd": "wait_frames", "n": 3, "expect_result": {"pointer": "/frames", "equals": 3}}

// A dialog slides in as it opens: a click on its button straight away waits for the button to
// stop moving, so it lands on it rather than where it was a frame before.
{"cmd": "click", "target": "dialog/open"}
{"cmd": "click", "target": "dialog/confirm", "expect": {"pointer": "/dialog_confirms", "equals": 1}}
{"cmd": "click", "target": "dialog/open"}
{"cmd": "click", "target": "dialog/confirm", "expect": {"pointer": "/dialog_confirms", "equals": 2}}
{"cmd": "wait", "ms": 50, "expect_result": {"pointer": "/waited_ms", "equals": 50}}
{"expect": [{"pointer": "/counter", "equals": 44}, {"pointer": "/missing", "exists": false}]}

// The target registry.
{"cmd": "bounds", "target": "counter/increment", "expect_result": [{"pointer": "/x", "equals": 16}, {"pointer": "/y", "equals": 16}, {"pointer": "/count", "equals": 1}, {"pointer": "/visible", "not_equals": null}]}
{"cmd": "query", "prefix": "counter/", "expect_result": [{"pointer": "", "len": 3}, {"pointer": "/0/target", "equals": "counter/increment"}]}
{"cmd": "query", "prefix": "list/row/", "expect_result": [{"pointer": "", "len": 60}, {"pointer": "/0/visible", "not_equals": null}, {"pointer": "/59/visible", "equals": null}]}

// Scrolling, then clicking a row that is only reachable after the scroll.
{"cmd": "scroll", "target": "list", "dy": -300, "expect": {"pointer": "/list/scroll_y", "equals": 300}}
{"cmd": "bounds", "target": "list/row/0", "expect_result": {"pointer": "/visible", "equals": null}}
{"cmd": "click", "target": "list/row/0", "expect_error": "clipped out of view"}
{"cmd": "click", "target": "list/row/12", "expect": {"pointer": "/list/selected", "equals": 12}}
{"cmd": "scroll", "target": "list", "dy": 1, "unit": "lines", "expect": [{"pointer": "/list/scroll_y", "lte": 299}, {"pointer": "/list/scroll_y", "gte": 250}]}
{"cmd": "screenshot", "name": "scrolled-list"}

// Hover.
{"cmd": "mouse_move", "target": "drag/item", "expect": {"pointer": "/drag/item_hovered", "equals": true}}
{"cmd": "mouse_move", "x": 700, "y": 500, "expect": {"pointer": "/drag/item_hovered", "equals": false}}

// A drag built from mouse_down, mouse_move and mouse_up.
{"cmd": "mouse_down", "target": "drag/item"}
{"cmd": "mouse_move", "target": "drag/target", "expect": {"pointer": "/drag/active", "equals": true}}
{"cmd": "mouse_up", "expect": [{"pointer": "/drag/item_in_target", "equals": true}, {"pointer": "/drag/active", "equals": false}]}
{"cmd": "mouse_up", "expect_error": "no mouse button is down"}
{"cmd": "drag", "to": [10, 10], "expect_error": "none is"}

// A frame-paced drag held mid-way: drag-over styling, a screenshot, then hover-to-expand (1s).
{"cmd": "reset_drag", "expect": [{"pointer": "/drag/item_in_target", "equals": false}, {"pointer": "/drag/target_expanded", "equals": false}]}
{"cmd": "drag", "from": "drag/item", "to": "drag/target", "steps": 8, "step_ms": 10, "release": false, "expect_result": {"pointer": "/released", "equals": false}, "expect": [{"pointer": "/drag/active", "equals": true}, {"pointer": "/drag/target_hovered", "equals": true}, {"pointer": "/drag/target_expanded", "equals": false}]}
{"cmd": "screenshot", "name": "mid-drag"}
{"cmd": "wait_for", "pointer": "/drag/target_expanded", "equals": true, "timeout_ms": 3000}
{"cmd": "screenshot", "name": "hover-expanded"}
{"cmd": "drag", "to": [330, 220], "steps": 3, "expect": [{"pointer": "/drag/item_in_target", "equals": true}, {"pointer": "/drag/active", "equals": false}]}

// The same in one command, holding over the target long enough to expand it.
{"cmd": "reset_drag"}
{"cmd": "drag", "from": "drag/item", "to": "drag/target", "hold_ms": 1300, "expect": [{"pointer": "/drag/target_expanded", "equals": true}, {"pointer": "/drag/item_in_target", "equals": true}, {"pointer": "/drag/active", "equals": false}]}

// External file drops: hover without dropping, drop, cancel, and a bad path.
{"cmd": "drop_files", "paths": ["${workspace}/crates/gpui_automation/tests/fixtures/drop/notes.txt", "${workspace}/crates/gpui_automation/tests/fixtures/drop/pixel.png"], "target": "drop-zone", "submit": false, "expect_result": {"pointer": "/outcome", "equals": "hovering"}, "expect": [{"pointer": "/drop_zone/hovered", "equals": true}, {"pointer": "/drag/active", "equals": true}, {"pointer": "/dropped", "len": 0}]}
{"cmd": "screenshot", "name": "files-hovering"}
{"cmd": "click", "target": "counter/increment", "expect_error": "files are still hovering"}
{"cmd": "drop_files", "target": "drop-zone", "hold_ms": 200, "expect_result": {"pointer": "/outcome", "equals": "dropped"}, "expect": [{"pointer": "/dropped", "equals": ["notes.txt", "pixel.png"]}, {"pointer": "/drag/active", "equals": false}, {"pointer": "/drop_zone/hovered", "equals": false}]}
{"cmd": "drop_files", "paths": ["${workspace}/crates/gpui_automation/tests/fixtures/drop/notes.txt"], "target": "drop-zone", "cancel": true, "expect_result": {"pointer": "/outcome", "equals": "cancelled"}, "expect": [{"pointer": "/dropped", "len": 2}, {"pointer": "/drag/active", "equals": false}]}
{"cmd": "drop_files", "paths": ["${workspace}/crates/gpui_automation/tests/fixtures/drop/missing.png"], "target": "drop-zone", "expect_error": "does not exist"}
{"cmd": "screenshot", "name": "files-dropped"}

// A second window: addressed per command, selected, closed, reopened by keystroke.
{"cmd": "click", "target": "second/open", "expect": [{"pointer": "/second/open", "equals": true}, {"pointer": "/windows", "len": 2}, {"pointer": "/windows/1/name", "equals": "second"}]}
{"cmd": "click", "window": "second", "target": "second/click", "expect": [{"pointer": "/view", "equals": "second"}, {"pointer": "/clicks", "equals": 1}]}
{"cmd": "window", "name": "second", "expect_result": [{"pointer": "/name", "equals": "second"}, {"pointer": "/index", "equals": 1}]}
{"cmd": "click", "target": "second/click", "expect": [{"pointer": "/view", "equals": "second"}, {"pointer": "/clicks", "equals": 2}]}
{"cmd": "screenshot", "name": "second-window", "expect_result": {"pointer": "/logical/w", "gte": 300}}
// The second window has a custom title bar and a 320x200 minimum, like dv's.
{"cmd": "resize", "window": "second", "w": 360, "h": 1700, "expect_result": [{"pointer": "/w", "equals": 360}, {"pointer": "/h", "equals": 1700}], "expect": [{"pointer": "/window/w", "equals": 360}, {"pointer": "/window/h", "equals": 1700}, {"pointer": "/clicks", "equals": 2}]}
{"cmd": "resize", "window": "second", "w": 300, "h": 150, "expect_error": "300x150 is below the window's minimum size of 320x200"}
{"cmd": "state", "window": "main", "expect_result": {"pointer": "/second/clicks", "equals": 2}}
{"cmd": "state", "window": 0, "expect_result": {"pointer": "/view", "equals": "main"}}
{"cmd": "state", "window": 7, "expect_error": "no open window #7"}
{"cmd": "click", "target": "second/close"}
{"expect": [{"pointer": "/window/name", "equals": "main"}, {"pointer": "/second/open", "equals": false}, {"pointer": "/windows", "len": 1}]}
{"cmd": "window", "name": "second", "expect_error": "no open window \"second\""}
{"cmd": "key", "keystroke": "ctrl-shift-n", "expect": {"pointer": "/second/open", "equals": true}}
{"cmd": "window", "index": 1, "expect_result": {"pointer": "/name", "equals": "second"}}
{"cmd": "click", "target": "second/close"}
{"cmd": "window", "index": 0, "expect_result": {"pointer": "/name", "equals": "main"}}

// Window geometry: a portrait size taller than most displays, the minimum size, then back.
{"cmd": "resize", "w": 1080, "h": 1920, "expect_result": [{"pointer": "/w", "equals": 1080}, {"pointer": "/h", "equals": 1920}], "expect": [{"pointer": "/window/w", "equals": 1080}, {"pointer": "/window/h", "equals": 1920}]}
{"cmd": "screenshot", "name": "portrait", "expect_result": [{"pointer": "/logical/w", "equals": 1080}, {"pointer": "/logical/h", "equals": 1920}, {"pointer": "/h", "gte": 1920}]}
{"cmd": "resize", "w": 20, "h": 10, "expect_error": "below the window's minimum"}
{"cmd": "resize", "w": 1000, "h": 700, "expect_result": {"pointer": "/w", "equals": 1000}, "expect": [{"pointer": "/window/w", "equals": 1000}, {"pointer": "/window/h", "equals": 700}]}
{"cmd": "screenshot", "name": "resized", "expect_result": [{"pointer": "/logical/w", "equals": 1000}, {"pointer": "/logical/h", "equals": 700}]}
{"cmd": "fullscreen", "on": true, "expect_result": {"pointer": "/fullscreen", "equals": true}, "expect": [{"pointer": "/window/fullscreen", "equals": true}, {"pointer": "/window/w", "gte": 1200}]}
{"cmd": "screenshot", "name": "fullscreen"}
{"cmd": "resize", "w": 900, "h": 600, "expect_error": "the window is fullscreen"}
{"cmd": "fullscreen", "on": false, "expect": [{"pointer": "/window/fullscreen", "equals": false}, {"pointer": "/window/w", "equals": 1000}]}
{"cmd": "resize", "w": 1200, "h": 800, "expect": {"pointer": "/window/w", "equals": 1200}}
{"cmd": "screenshot", "name": "end"}

// Restarts: the same data dir, window size and environment; state starts over; screenshot numbering continues.
{"restart": {}, "expect_result": [{"pointer": "/event", "equals": "ready"}, {"pointer": "/windows", "len": 1}], "expect": [{"pointer": "/counter", "equals": 0}, {"pointer": "/data_dir", "equals": "${data_dir}"}, {"pointer": "/cwd", "equals": "${data_dir}"}, {"pointer": "/env/DV_DATA_DIR", "equals": "${data_dir}"}, {"pointer": "/env/DV_GH", "equals": "${dv_gh}"}, {"pointer": "/env/DV_MOCK_GH", "equals": null}, {"pointer": "/env/DV_MOCK_GH_LOG", "equals": "${dv_mock_gh_log}"}, {"pointer": "/window/w", "equals": 1200}, {"pointer": "/window/h", "equals": 800}]}
{"cmd": "click", "target": "counter/increment", "expect": {"pointer": "/counter", "equals": 1}}
{"cmd": "screenshot", "name": "restarted"}
// After an explicit quit only a restart (or a gh_log without expect) may follow; this one swaps the app args.
{"cmd": "quit", "expect_result": {"pointer": "/quitting", "equals": true}}
{"gh_log": {}, "expect_result": {"pointer": "", "len": 0}}
{"restart": {"app_args": ["--counter", "7"]}, "expect": {"pointer": "/counter", "equals": 7}}
{"cmd": "screenshot", "name": "restarted-with-args"}
// Without --data-dir the app still gets the scenario's data dir, through DV_DATA_DIR; "data_dir": true puts the flag back. The swapped app args carry on.
{"restart": {"data_dir": false}, "expect": [{"pointer": "/data_dir", "equals": null}, {"pointer": "/env/DV_DATA_DIR", "equals": "${data_dir}"}, {"pointer": "/counter", "equals": 7}]}
{"restart": {"data_dir": true}, "expect": [{"pointer": "/data_dir", "equals": "${data_dir}"}, {"pointer": "/env/DV_DATA_DIR", "equals": "${data_dir}"}]}
{"cmd": "quit", "expect_result": {"pointer": "/quitting", "equals": true}}
