{"scenario": {"gh": "fixtures/gh/harness.json", "window_size": "900x600", "description": "The runner's mock_gh wiring against mock_gh: DV_GH, DV_MOCK_GH and DV_MOCK_GH_LOG, gh_log steps, and the log across a restart"}}
{"cmd": "wait_ready", "timeout_ms": 10000}
{"cmd": "state", "expect_result": [{"pointer": "/env/DV_GH", "equals": "${dv_gh}"}, {"pointer": "/env/DV_MOCK_GH", "equals": "${dv_mock_gh}"}, {"pointer": "/env/DV_MOCK_GH", "contains": "harness.json"}, {"pointer": "/env/DV_MOCK_GH_LOG", "equals": "${dv_mock_gh_log}"}, {"pointer": "/cwd", "equals": "${data_dir}"}]}
{"gh_log": {}, "expect_result": {"pointer": "", "len": 0}}

// A matched call answers with the entry's stdout and exit code.
{"cmd": "run_gh", "args": ["pr", "view", "482", "--json", "number,title"], "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/stdout", "contains": "Harness PR"}]}
// Entries can match on stdin too; the first matching entry with calls left answers.
{"cmd": "run_gh", "args": ["api", "repos/o/r/pulls/482/reviews", "--input", "-"], "stdin": "{\"event\":\"COMMENT\"}", "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/stdout", "contains": "7"}]}
{"cmd": "run_gh", "args": ["api", "repos/o/r/pulls/482/reviews", "--input", "-"], "stdin": "{\"event\":\"APPROVE\"}", "expect_result": [{"pointer": "/exit", "equals": 1}, {"pointer": "/stderr", "contains": "HTTP 422"}]}
// An unmatched call exits 64 with mock_gh's message.
{"cmd": "run_gh", "args": ["auth", "status"], "expect_result": [{"pointer": "/exit", "equals": 64}, {"pointer": "/stderr", "contains": "mock_gh: no scenario entry for argv"}]}

// Every call is in the log, in order, with its stdin (null when its arguments don't ask gh to read stdin) and the entry that answered it.
{"gh_log": {}, "expect_result": [{"pointer": "", "len": 4}, {"pointer": "/0/argv", "equals": ["pr", "view", "482", "--json", "number,title"]}, {"pointer": "/0/matched", "equals": 0}, {"pointer": "/0/stdin", "equals": null}, {"pointer": "/1/stdin", "equals": "{\"event\":\"COMMENT\"}"}, {"pointer": "/1/matched", "equals": 1}, {"pointer": "/2/matched", "equals": 2}, {"pointer": "/3/argv", "equals": ["auth", "status"]}, {"pointer": "/3/matched", "equals": null}], "expect": {"pointer": "/view", "equals": "main"}, "save": {"subcommand": "/0/argv/1"}}
{"cmd": "echo", "saved": "${subcommand}", "expect_result": {"pointer": "/saved", "equals": "view"}}

// The log outlives the app: it is read after quit, and the relaunched app adds to it. Entry 0's one call is used up.
{"cmd": "quit"}
{"gh_log": {}, "expect_result": {"pointer": "", "len": 4}}
{"restart": {}, "expect": [{"pointer": "/env/DV_MOCK_GH", "equals": "${dv_mock_gh}"}, {"pointer": "/env/DV_MOCK_GH_LOG", "equals": "${dv_mock_gh_log}"}]}
{"cmd": "run_gh", "args": ["pr", "view", "482", "--json", "number,title"], "expect_result": {"pointer": "/exit", "equals": 64}}
{"gh_log": {}, "expect_result": [{"pointer": "", "len": 5}, {"pointer": "/4/matched", "equals": null}]}
